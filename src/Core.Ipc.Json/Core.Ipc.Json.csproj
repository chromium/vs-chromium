<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JSON serialization of the protocol messages (VsChromium.Core.Ipc), and the stream exchanging them
    as JSON lines over the server standard input/output. Used by the server and the Visual Studio
    package (the VS Code extension has its own TypeScript implementation, src/vscode/src/server).
    netstandard2.0, for the same reasons as VsChromium.Core.Ipc.
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>VsChromium.Core.Ipc.Json</AssemblyName>
    <RootNamespace>VsChromium.Core.Ipc.Json</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Ipc\Core.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets: not flowed to the Visual Studio package, which uses the Newtonsoft.Json
         assembly of Visual Studio (from the VS SDK, not shipped in the VSIX). The server references
         it explicitly. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
