<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Message types of the protocol between the clients (Visual Studio package, VS Code extension) and
    the indexing server, and their JSON serialization (the protocol over the server standard
    input/output). netstandard2.0, so it can be used both by the Visual Studio package (.NET Framework,
    runs inside devenv.exe) and by the server (modern .NET). Must not depend on anything else than
    Newtonsoft.Json (no Win32, no MEF, no logging).
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>VsChromium.Core.Ipc</AssemblyName>
    <RootNamespace>VsChromium.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- PrivateAssets: not flowed to the Visual Studio package, which uses the Newtonsoft.Json
         assembly of Visual Studio (from the VS SDK, not shipped in the VSIX). The server references
         it explicitly. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
