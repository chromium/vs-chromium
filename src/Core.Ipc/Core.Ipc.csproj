<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Message types of the protocol between the Visual Studio package and the indexing server, client
    side: plain data classes (their JSON serialization is in VsChromium.Core.Ipc.Json). The server has
    its own copy of the message classes (src/Core.Server/Ipc), and the VS Code extension its own
    TypeScript definitions: the protocol is the JSON format, not this assembly. Must not depend on
    anything (no serializer, no Win32, no MEF, no logging).
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>VsChromium.Core.Ipc</AssemblyName>
    <RootNamespace>VsChromium.Core</RootNamespace>
  </PropertyGroup>

</Project>
