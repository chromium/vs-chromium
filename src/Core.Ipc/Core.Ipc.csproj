<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Message types of the protocol between the clients (Visual Studio package, VS Code extension) and
    the indexing server: plain data classes (their JSON serialization is in VsChromium.Core.Ipc.Json).
    netstandard2.0, so it can be used both by the Visual Studio package (.NET Framework, runs inside
    devenv.exe) and by the server (modern .NET). Must not depend on anything (no serializer, no Win32,
    no MEF, no logging).
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>VsChromium.Core.Ipc</AssemblyName>
    <RootNamespace>VsChromium.Core</RootNamespace>
  </PropertyGroup>

</Project>
