<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core library of the indexing server, on modern .NET (see docs/portable-server/PORTING_PRINCIPLES.md).

    The server and the Visual Studio package are independent code bases: no source file is shared
    with src/Core, src/Core.Ipc or src/Core.Ipc.Json (the Visual Studio side). The files of these
    projects used by the server were copied here (same relative paths and namespaces) when the two
    code bases were severed, and evolve independently. Only the protocol (JSON messages over the
    standard input/output of the server) is common, and is tested by src/Tests.EndToEnd (server) and
    the client tests.

    - Ipc\: protocol message classes (Ipc\TypedMessages) and their JSON serialization (Ipc\Json).
    - Files\, Collections\, Configuration\, Logging\, ...: paths, pattern matching, file system,
      configuration files, logging, collections.
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VsChromium.Core.Server</AssemblyName>
    <RootNamespace>VsChromium.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No reflection: enables the trimming and NativeAOT analyzers (warnings are errors). -->
    <IsAotCompatible>true</IsAotCompatible>
    <OutputPath>$(BuildRoot)Binaries\$(Configuration)\Server\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Code copied from mtsuite (OS-aware path helpers), see third_party/mtsuite/PORT_CHANGES.md. -->
    <ProjectReference Include="..\..\third_party\mtsuite\MtSuite.CoreFileSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.2" />
  </ItemGroup>

</Project>
