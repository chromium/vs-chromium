<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code shared by the Visual Studio package (devenv.exe), VsChromium.Host.exe, the Concord
    debugger integration and the indexing server. Stays on .NET Framework (the VS package requires
    it); see docs/portable-server/PORTING_PRINCIPLES.md for the split planned by the port.
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VsChromium.Core</AssemblyName>
    <RootNamespace>VsChromium.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Ipc\Core.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="4.4.12" />
    <PackageReference Include="protobuf-net" Version="2.4.9" />
  </ItemGroup>

</Project>
