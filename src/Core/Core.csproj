<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code shared by the Visual Studio package (devenv.exe) and the Concord debugger integration.
    Stays on .NET Framework (the VS package requires it). The indexing server is an independent code
    base (src/Server) and shares no source file with this project.
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VsChromium.Core</AssemblyName>
    <RootNamespace>VsChromium.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="4.4.12" />
  </ItemGroup>

</Project>
