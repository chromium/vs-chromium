<Project Sdk="MSTest.Sdk/4.5.2">

  <!--
    Unit tests of the indexing server (white box): VsChromium.Server and VsChromium.Core.Server, on
    modern .NET. The Visual Studio side tests are in
    src/Tests (net472), the black-box end-to-end tests and benchmarks in src/Tests.EndToEnd.

    Run: cd src/Server.Tests; dotnet test
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VsChromium.Server.Tests</AssemblyName>
    <RootNamespace>VsChromium.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputPath>$(BuildRoot)Binaries\$(Configuration)\Server.Tests\</OutputPath>
    <!-- Ported tests: allow the MSTest analyzers suggestions without failing the build. -->
    <NoWarn>$(NoWarn);MSTEST0001;MSTEST0006;MSTEST0017;MSTEST0025;MSTEST0032;MSTEST0037;MSTEST0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Server\Core.Server.csproj" />
    <ProjectReference Include="..\Server\Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default configuration files, looked up next to VsChromium.Core.Server.dll. -->
    <None Include="..\Server\Configuration\*" Link="Configuration\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
