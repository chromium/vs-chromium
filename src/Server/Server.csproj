<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The indexing and search server (VsChromium.Server.exe), used by the Visual Studio package and the
    VS Code extension through its protocol (JSON-RPC over standard input/output, see
    protocol/README.md). Portable modern .NET; an independent code base, sharing no source file with
    the Visual Studio side (see docs/portable-server/PORTING_PRINCIPLES.md).

    Output: Binaries\<Configuration>\Server\ (the server has its own dependencies, different from the
    Visual Studio side ones in Binaries\<Configuration>\).
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VsChromium.Server</AssemblyName>
    <RootNamespace>VsChromium.Server</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No reflection: enables the trimming and NativeAOT analyzers (warnings are errors). -->
    <IsAotCompatible>true</IsAotCompatible>
    <OutputPath>$(BuildRoot)Binaries\$(Configuration)\Server\</OutputPath>
    <!-- Same GC settings as the .NET Framework server (workstation GC, concurrent). To be revisited
         with benchmarks. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!--
    Publishing (dotnet publish -c Release -r <rid>, e.g. win-x64): a self-contained, single file,
    ReadyToRun executable, so that users don't need to install a .NET runtime and most of the code
    doesn't need to be compiled by the JIT at startup (see also the NativeAOT switch below).
    Output: Binaries\<Configuration>\ServerPublish\<rid>\ (VsChromium.Server.exe and the default
    configuration files in Configuration\).
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- No compression of the bundled assemblies: bigger executable, but faster startup (compressed
         assemblies are extracted in memory at each startup). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Debug symbols embedded in the assemblies (no separate .pdb files to ship). -->
    <DebugType>embedded</DebugType>
    <!-- Intermediate RID specific build output: must not overwrite the regular (framework-dependent)
         build output in Binaries\<Configuration>\Server\. -->
    <!-- (The runtime identifier is appended to both the output and the intermediate paths, so that
         publishing for several runtime identifiers doesn't mix files, e.g. app hosts.) -->
    <AppendRuntimeIdentifierToOutputPath>true</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(BuildRoot)Binaries\$(Configuration)\ServerBuild\</OutputPath>
    <PublishDir>$(BuildRoot)Binaries\$(Configuration)\ServerPublish\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>

  <!--
    Experimental: NativeAOT publishing (dotnet publish -c Release -r <rid> -p:VsChromiumPublishAot=true),
    to check the AOT compatibility of the server (trimming/AOT analysis warnings). Not used for
    packaging.
  -->
  <PropertyGroup Condition="'$(VsChromiumPublishAot)' == 'true' And '$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PublishDir>$(BuildRoot)Binaries\$(Configuration)\ServerPublishAot\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default configuration files, looked up in AppContext.BaseDirectory\Configuration (ConfigurationFileLocator). -->
    <None Update="Configuration\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    Protocol code (Protocol\Generated\Protocol.g.cs, namespace VsChromium.Protocol.Generated), generated from the protocol definition (protocol\*.tsp)
    by src\Tools\ProtocolGen before compiling, when a definition file or the generator changed. The
    generated file is checked in (diffs show the effect of protocol changes). The generator is a
    build-only reference: Private="false" and PrivateAssets="all" keep its executable out of the
    build and publish outputs of Server.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Tools\ProtocolGen\ProtocolGen.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishReadyToRun;PublishSingleFile;PublishAot" />
    <ProtocolDefinition Include="$(BuildRoot)protocol\*.tsp" />
  </ItemGroup>

  <PropertyGroup>
    <ProtocolGenAssembly>$(BuildRoot)Binaries\$(Configuration)\Tools\ProtocolGen\VsChromium.ProtocolGen.dll</ProtocolGenAssembly>
    <ProtocolGeneratedFile>$(MSBuildProjectDirectory)\Protocol\Generated\Protocol.g.cs</ProtocolGeneratedFile>
    <!-- The client outputs (VS Code, Visual Studio) are generated by the same step (single place). -->
    <ProtocolGeneratedTsFile>$(BuildRoot)src\vscode\src\protocol\protocol.g.ts</ProtocolGeneratedTsFile>
    <ProtocolGeneratedVsFile>$(BuildRoot)src\VsChromium\Protocol\Generated\Protocol.g.cs</ProtocolGeneratedVsFile>
  </PropertyGroup>

  <Target Name="GenerateProtocol"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences"
          Inputs="@(ProtocolDefinition);$(ProtocolGenAssembly)"
          Outputs="$(ProtocolGeneratedFile);$(ProtocolGeneratedTsFile);$(ProtocolGeneratedVsFile)">
    <Exec Command="dotnet &quot;$(ProtocolGenAssembly)&quot; --input &quot;$(BuildRoot)protocol&quot; --server-cs &quot;$(ProtocolGeneratedFile)&quot; --ts &quot;$(ProtocolGeneratedTsFile)&quot; --vs-cs &quot;$(ProtocolGeneratedVsFile)&quot;" />
    <!-- The generator only writes changed files: update the timestamp for the incremental check. -->
    <Touch Files="$(ProtocolGeneratedFile);$(ProtocolGeneratedTsFile);$(ProtocolGeneratedVsFile)" />
  </Target>

</Project>
