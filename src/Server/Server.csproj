<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The indexing and search server (VsChromium.Server.exe), used by the Visual Studio package and the
    VS Code extension. Still .NET Framework + native code (VsChromium.Native.dll); to be ported to
    portable modern .NET, see docs/portable-server/PORTING_PRINCIPLES.md.
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VsChromium.Server</AssemblyName>
    <RootNamespace>VsChromium.Server</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Ipc\Core.Ipc.csproj" />
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\ServerNativeInterop\ServerNativeInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="protobuf-net" Version="2.4.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default configuration files, looked up next to VsChromium.Core.dll (ConfigurationFileLocator). -->
    <None Update="Configuration\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
