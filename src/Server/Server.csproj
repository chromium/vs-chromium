<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The indexing and search server (VsChromium.Server.exe), used by the Visual Studio package and the
    VS Code extension. On modern .NET, without native code of its own, still using Win32 APIs (file system)
    for now; to be made portable, see docs/portable-server/PORTING_PRINCIPLES.md.

    Output: Binaries\<Configuration>\Server\ (the server has its own dependencies, different from the
    Visual Studio side ones in Binaries\<Configuration>\).
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VsChromium.Server</AssemblyName>
    <RootNamespace>VsChromium.Server</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>$(BuildRoot)Binaries\$(Configuration)\Server\</OutputPath>
    <!-- Same GC settings as the .NET Framework server (workstation GC, concurrent). To be revisited
         with benchmarks. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core.Ipc\Core.Ipc.csproj" />
    <ProjectReference Include="..\Core.Server\Core.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="protobuf-net" Version="2.4.9" />
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default configuration files, looked up next to VsChromium.Core.Server.dll (ConfigurationFileLocator). -->
    <None Update="Configuration\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
