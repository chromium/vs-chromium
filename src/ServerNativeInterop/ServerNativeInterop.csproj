<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P/Invoke wrappers of VsChromium.Native.dll (C++ search algorithms). To be replaced by managed
    code and deleted by the port (see docs/portable-server/PORTING_PRINCIPLES.md).
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>VsChromium.Server.NativeInterop</AssemblyName>
    <RootNamespace>VsChromium.Server.NativeInterop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>
