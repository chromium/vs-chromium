<Project Sdk="MSTest.Sdk/4.5.2">

  <!--
    Tests of the protocol generator (src/Tools/ProtocolGen): parsing of the TypeSpec subset, rules of
    the protocol, generated code, and the generated files of the repository being up to date.

    Run: cd src/Tools/ProtocolGen.Tests; dotnet test
  -->

  <Import Project="..\..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VsChromium.ProtocolGen.Tests</AssemblyName>
    <RootNamespace>VsChromium.ProtocolGen.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <OutputPath>$(BuildRoot)Binaries\$(Configuration)\Tools\ProtocolGen.Tests\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProtocolGen\ProtocolGen.csproj" />
  </ItemGroup>

</Project>
