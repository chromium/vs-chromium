  <!-- The indexing server (modern .NET, Server.csproj) is included in the VSIX in a "Server"
       sub-directory (see ServerLocation and ServerProcessLauncher):
       - Release ("Published" layout): the self-contained, single file, ReadyToRun executables
         published for win-x64 and win-arm64 (Binaries\Release\ServerPublish\<rid>\, published here
         with "dotnet publish"), in Server\win-x64\ and Server\win-arm64\: one VSIX for x64 and
         ARM64 Visual Studio; the package starts the server of the native architecture of Windows
         (also when Visual Studio runs as an emulated x64 process on ARM64 Windows), and users don't
         need to install a .NET runtime. With -p:VsChromiumPublishServer=false, the servers already
         published in Binaries\Release\ServerPublish\<rid>\ are packaged as is (release workflow,
         see docs/release.md).
       - Debug ("Build" layout): the framework-dependent build (Binaries\Debug\Server\, built before
         this project, see the solution dependencies), in Server\, faster to build and to debug;
         requires the .NET runtime. -->
  <PropertyGroup>
    <VsChromiumServerLayout Condition="'$(VsChromiumServerLayout)' == '' And '$(Configuration)' == 'Release'">Published</VsChromiumServerLayout>
    <VsChromiumServerLayout Condition="'$(VsChromiumServerLayout)' == ''">Build</VsChromiumServerLayout>
    <VsChromiumPublishServer Condition="'$(VsChromiumPublishServer)' == ''">true</VsChromiumPublishServer>
    <VsChromiumServerPublishDir>$(OutputPath)ServerPublish\</VsChromiumServerPublishDir>
    <VsChromiumServerBuildDir>$(OutputPath)Server\</VsChromiumServerBuildDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Must match the folders of ServerLocation. -->
    <VsChromiumServerRuntimeIdentifier Include="win-x64;win-arm64" />
  </ItemGroup>
  <Target Name="PublishServerForVsix" BeforeTargets="GetVsixSourceItems" Condition="'$(VsChromiumServerLayout)' == 'Published' And '$(VsChromiumPublishServer)' == 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\Server\Server.csproj&quot; -c $(Configuration) -r %(VsChromiumServerRuntimeIdentifier.Identity) --nologo -v:quiet" />
  </Target>
  <Target Name="IncludeServerInVsix" BeforeTargets="GetVsixSourceItems" DependsOnTargets="PublishServerForVsix">
    <Error Condition="'$(VsChromiumServerLayout)' == 'Published' And !Exists('$(VsChromiumServerPublishDir)%(VsChromiumServerRuntimeIdentifier.Identity)\VsChromium.Server.exe')"
           Text="The server must be published before the VSIX: $(VsChromiumServerPublishDir)%(VsChromiumServerRuntimeIdentifier.Identity)\VsChromium.Server.exe not found." />
    <Error Condition="'$(VsChromiumServerLayout)' == 'Build' And !Exists('$(VsChromiumServerBuildDir)VsChromium.Server.exe')"
           Text="The server must be built before the VSIX: $(VsChromiumServerBuildDir)VsChromium.Server.exe not found." />
    <ItemGroup Condition="'$(VsChromiumServerLayout)' == 'Published'">
      <_VsChromiumServerFile Include="$(VsChromiumServerPublishDir)win-x64\**\*" Exclude="$(VsChromiumServerPublishDir)win-x64\**\*.pdb">
        <ServerSubPath>win-x64\</ServerSubPath>
      </_VsChromiumServerFile>
      <_VsChromiumServerFile Include="$(VsChromiumServerPublishDir)win-arm64\**\*" Exclude="$(VsChromiumServerPublishDir)win-arm64\**\*.pdb">
        <ServerSubPath>win-arm64\</ServerSubPath>
      </_VsChromiumServerFile>
    </ItemGroup>
    <ItemGroup Condition="'$(VsChromiumServerLayout)' == 'Build'">
      <_VsChromiumServerFile Include="$(VsChromiumServerBuildDir)**\*">
        <ServerSubPath></ServerSubPath>
      </_VsChromiumServerFile>
    </ItemGroup>
    <ItemGroup>
      <!-- Note: "%(_VsChromiumServerFile.RecursiveDir)" (batching) is needed to preserve the
           sub-directories (e.g. Configuration\), "%(RecursiveDir)" is empty here. -->
      <VSIXSourceItem Include="@(_VsChromiumServerFile)">
        <VSIXSubPath>Server\%(_VsChromiumServerFile.ServerSubPath)%(_VsChromiumServerFile.RecursiveDir)</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
  <!-- Builds the server dashboard page with the VS Code extension tooling (src\vscode: TypeScript
       compiler and bundler) when its sources changed, so that the solution builds and runs (F5)
       without manual steps: "npm ci" the first time (node_modules missing), then
       "npm run compile:page". Requires Node.js. -->
  <PropertyGroup>
    <DashboardPageProjectDir>$(BuildRoot)src\vscode\</DashboardPageProjectDir>
  </PropertyGroup>
  <ItemGroup>
    <DashboardPageInput Include="$(DashboardPageProjectDir)src\ui\**\*.ts" />
    <DashboardPageInput Include="$(DashboardPageProjectDir)src\protocol\*.ts" />
    <DashboardPageInput Include="$(DashboardPageProjectDir)tsconfig.json;$(DashboardPageProjectDir)tsconfig.page.json" />
    <DashboardPageInput Include="$(DashboardPageProjectDir)scripts\bundle-page.js;$(DashboardPageProjectDir)package-lock.json" />
  </ItemGroup>
  <Target Name="BuildDashboardPage" BeforeTargets="BeforeBuild" Inputs="@(DashboardPageInput)" Outputs="$(DashboardPageScript)">
    <Exec Command="node --version" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_DashboardNodeExitCode" />
    </Exec>
    <Error Condition="'$(_DashboardNodeExitCode)' != '0'"
           Text="Node.js is required to build the server dashboard page (src\vscode): install Node.js (https://nodejs.org), then rebuild." />
    <Exec Condition="!Exists('$(DashboardPageProjectDir)node_modules\typescript')" Command="npm ci --no-audit --no-fund" WorkingDirectory="$(DashboardPageProjectDir)" />
    <Exec Command="npm run compile:page" WorkingDirectory="$(DashboardPageProjectDir)" />
  </Target>
  <Target Name="CheckDashboardPage" BeforeTargets="BeforeBuild" DependsOnTargets="BuildDashboardPage">
    <Error Condition="!Exists('$(DashboardPageScript)')"
           Text="The server dashboard page is missing: $(DashboardPageScript). It is built from src\vscode (npm run compile:page); see the build output above." />
  </Target>
