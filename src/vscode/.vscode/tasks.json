{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "label": "npm: compile"
    },
    {
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/../Server/Server.csproj", "--nologo", "-v:minimal"],
      "problemMatcher": "$msCompile",
      "label": "dotnet: build server"
    },
    {
      "label": "build",
      "dependsOn": ["npm: compile", "dotnet: build server"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "label": "npm: watch"
    }
  ]
}
