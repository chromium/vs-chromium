<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code copied from mtsuite (same author, Apache License 2.0, see LICENSE in
    this directory), used by the VsChromium server. See PORT_CHANGES.md for the origin commit, the
    files copied and the changes made, to be backported to mtsuite (goal: a reusable mtsuite file
    system library).
  -->

  <Import Project="..\..\Build\Common.Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MtSuite.CoreFileSystem</AssemblyName>
    <RootNamespace>mtsuite.CoreFileSystem</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Files are listed explicitly below. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Product>mtsuite</Product>
    <Copyright>Copyright 2026 Renaud Paquay</Copyright>
    <!-- The server and its dependencies go to their own directory. -->
    <OutputPath>$(BuildRoot)Binaries\$(Configuration)\Server\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the files used by the server are copied (see PORT_CHANGES.md). -->
    <Compile Include="src\core-filesystem\PathHelpers.cs" />
  </ItemGroup>

</Project>


